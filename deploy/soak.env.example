# Private soak — copy to soak.env (gitignored):
#   cp deploy/soak.env.example deploy/soak.env
#
# Use:
#   docker compose -f deploy/docker-compose.soak.yml --env-file deploy/soak.env up --build

# Compose profile: devnet (in-process 3-validator + RPC) | multi (3 containers)
COMPOSE_PROFILES=devnet

# Optional project name (isolates containers/networks from public stack)
COMPOSE_PROJECT_NAME=dew-private

# Host port published for JSON-RPC (devnet + multi node-0)
DEW_HTTP_PORT=8545

# multi profile only — host ports for node-1 / node-2 RPC and P2P
DEW_NODE1_HTTP_PORT=8546
DEW_NODE2_HTTP_PORT=8547
DEW_NODE0_P2P_PORT=30303
DEW_NODE1_P2P_PORT=30304
DEW_NODE2_P2P_PORT=30305
