# Copy to explorer.env (gitignored) and edit for your network.
# Used by: docker compose -f deploy/explorer/docker-compose.yml --env-file deploy/explorer/explorer.env
#
# Default: pull GHCR (path B PUBLIC_* already baked). Custom RPC/base → up --build.

# Host bind/port for the explorer nginx container (loopback when host nginx edges TLS)
EXPLORER_BIND=127.0.0.1
EXPLORER_PORT=8082

EXPLORER_IMAGE=ghcr.io/dewnetwork/dew-explorer:latest
PULL_POLICY=always

# --- Vite build-time PUBLIC_* (only with docker compose … --build; no secrets) ---

# JSON-RPC the *browser* will call (must be CORS-reachable from the explorer origin).
# Local combined stack: http://127.0.0.1:8545
# Public path B:        https://rpc-dew.fadosoft.com
PUBLIC_RPC_URL=https://rpc-dew.fadosoft.com

# Must match network (public-testnet-v1)
PUBLIC_CHAIN_ID=2205

# Canonical explorer base for share links and MetaMask “Block explorer URL”
# Local:  http://127.0.0.1:8082
# Public: https://explorer-dew.fadosoft.com
PUBLIC_EXPLORER_BASE=https://explorer-dew.fadosoft.com

# Optional market strip (no on-chain oracle — operator-provided display only)
# PUBLIC_DEW_PRICE_USD=0.01
# PUBLIC_DEW_PRICE_BTC=0.0000001
# PUBLIC_DEW_PRICE_CHANGE_24H=1.42
# PUBLIC_DEW_MARKET_CAP_USD=1000000
# PUBLIC_DEW_TOTAL_SUPPLY=100000000
