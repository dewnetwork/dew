# Public path B — copy to public.env (gitignored):
#   cp deploy/node/public.env.example deploy/node/public.env
#
# Use:
#   docker compose -f deploy/node/docker-compose.yml --env-file deploy/node/public.env up --build

# Optional project name (isolates containers/networks from soak stack)
COMPOSE_PROJECT_NAME=dew-public

# Host ports for nginx proxy (Dew itself is not published; always :8545 inside compose)
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443

# Image after local build (override to pull a registry image later)
DEW_IMAGE=dew:local

# nginx image
NGINX_IMAGE=nginx:1.27-alpine

# Public hostnames under *-dew.fadosoft.com (DNS A/AAAA → this host)
# Prefer host edge: deploy/nginx/dew-edge.conf + deploy/scripts/setup-certbot.sh
RPC_SERVER_NAME=rpc-dew.fadosoft.com
FAUCET_SERVER_NAME=faucet-dew.fadosoft.com
EXPLORER_SERVER_NAME=explorer-dew.fadosoft.com
