# Multi-stage build for the Dew Faucet React Frontend (faucet-web).
# Build from repo root:
#   docker build -f deploy/faucet/Dockerfile.web -t dew-faucet-web:local .

FROM node:20-alpine AS build
WORKDIR /app

# Install pnpm
RUN npm install -g pnpm

# Copy project manifests from faucet-web folder
COPY faucet-web/package.json faucet-web/pnpm-lock.yaml* ./
RUN pnpm install --frozen-lockfile

# Copy the frontend application source
COPY faucet-web/ ./

# Define build arguments that Vite can statically bundle at build time
ARG PUBLIC_FAUCET_API_URL
ARG PUBLIC_EXPLORER_URL
ARG PUBLIC_CAPTCHA_PROVIDER
ARG PUBLIC_CAPTCHA_SITE_KEY

ENV PUBLIC_FAUCET_API_URL=$PUBLIC_FAUCET_API_URL
ENV PUBLIC_EXPLORER_URL=$PUBLIC_EXPLORER_URL
ENV PUBLIC_CAPTCHA_PROVIDER=$PUBLIC_CAPTCHA_PROVIDER
ENV PUBLIC_CAPTCHA_SITE_KEY=$PUBLIC_CAPTCHA_SITE_KEY

# Build production static bundle
RUN pnpm build

# Serve stage via Nginx
FROM nginx:stable-alpine
COPY --from=build /app/dist /usr/share/nginx/html

# Custom nginx config to serve static frontend and proxy backend API
COPY deploy/faucet/nginx/dew-faucet.docker.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
