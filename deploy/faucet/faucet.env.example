# Copy to /etc/dew/faucet.env (mode 0600) or deploy/faucet/faucet.env for compose.
# Never commit real keys.
#
# Compose (GHCR): docker compose -f deploy/faucet/docker-compose.yml --env-file deploy/faucet/faucet.env up -d

# GHCR images (pin after release, e.g. …:0.2.0)
FAUCET_IMAGE=ghcr.io/dewnetwork/dew-faucet:latest
FAUCET_WEB_IMAGE=ghcr.io/dewnetwork/dew-faucet-web:latest
PULL_POLICY=always

# HTTP bind — put host nginx edge (deploy/nginx/dew-edge.conf) in front for public TLS.
FAUCET_LISTEN=127.0.0.1:8080

# Chain JSON-RPC (path B: often http://127.0.0.1:8545 behind private network)
FAUCET_RPC_URL=http://127.0.0.1:8545
FAUCET_CHAIN_ID=2205

# Public hostnames (publish / DNS under *-dew.fadosoft.com)
# FAUCET_PUBLIC_URL=https://faucet-dew.fadosoft.com
# PUBLIC_EXPLORER_URL=https://explorer-dew.fadosoft.com


# Funded key for public-testnet-v1 — NOT Anvil #0
FAUCET_PRIVATE_KEY=

# Mode: allowlist | captcha | dev
# Public default: allowlist (or captcha for open mint)
FAUCET_MODE=allowlist
FAUCET_ALLOWLIST=/etc/dew/faucet-allowlist.txt

# Captcha mode (when FAUCET_MODE=captcha)
# FAUCET_CAPTCHA_PROVIDER=turnstile
# FAUCET_CAPTCHA_SECRET=

# 1 DEW default (1e18 wei)
FAUCET_AMOUNT_WEI=1000000000000000000

# Rate limits (operator defaults)
FAUCET_LIMIT_ADDRESS=1
FAUCET_LIMIT_ADDRESS_WINDOW=24h
FAUCET_LIMIT_IP=10
FAUCET_LIMIT_IP_WINDOW=1h

# Behind nginx/Caddy: trust X-Forwarded-For
FAUCET_TRUSTED_PROXY=true

# Local only — never true on public
FAUCET_ALLOW_ANVIL_KEY=false
