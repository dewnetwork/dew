# --- Dew Blockchain Node Configuration ---
DEW_HTTP_PORT=8545

# --- Faucet Service Configuration ---
FAUCET_PORT=8081
FAUCET_CHAIN_ID=2205

# Funded private key for the Faucet backend (default is Anvil account #0 for local testing)
# NEVER commit real production keys to git!
FAUCET_PRIVATE_KEY=ac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Admission Mode: allowlist | captcha | dev
FAUCET_MODE=dev

# Allowlist path if FAUCET_MODE=allowlist (relative to deploy/ directory)
FAUCET_ALLOWLIST_PATH=../faucet/allowlist.example.txt

# Amount to transfer per request in Wei (1000000000000000000 Wei = 1 DEW)
FAUCET_AMOUNT_WEI=1000000000000000000

# Rate limits per address
FAUCET_LIMIT_ADDRESS=1
FAUCET_LIMIT_ADDRESS_WINDOW=24h

# Rate limits per client IP
FAUCET_LIMIT_IP=10
FAUCET_LIMIT_IP_WINDOW=1h

# --- Faucet Frontend Configuration (Passed via Docker Build Args) ---
# Deep-link base URL to explorer for successfully mined transaction hashes
PUBLIC_EXPLORER_URL=http://localhost:8082

# Captcha configuration for faucet-web frontend (if FAUCET_MODE=captcha)
# Captcha provider: turnstile | hcaptcha
PUBLIC_CAPTCHA_PROVIDER=turnstile
# Public site key for turnstile/hcaptcha
PUBLIC_CAPTCHA_SITE_KEY=

# --- Block Explorer SPA (Vite PUBLIC_* build args; no secrets) ---
EXPLORER_PORT=8082
# Browser-facing JSON-RPC (must be reachable from the user's browser, not Docker DNS)
PUBLIC_RPC_URL=http://127.0.0.1:8545
PUBLIC_CHAIN_ID=2205
PUBLIC_EXPLORER_BASE=http://localhost:8082
# Optional market strip display
# PUBLIC_DEW_PRICE_USD=0.01
# PUBLIC_DEW_PRICE_BTC=
# PUBLIC_DEW_PRICE_CHANGE_24H=
# PUBLIC_DEW_MARKET_CAP_USD=
# PUBLIC_DEW_TOTAL_SUPPLY=
