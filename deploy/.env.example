# Combined stack (GHCR pull by default):
#   docker compose -f deploy/docker-compose.yml --env-file deploy/.env pull
#   docker compose -f deploy/docker-compose.yml --env-file deploy/.env up -d
# Source rebuild: … up --build -d
#
# TLS — pick ONE (details: deploy/README.md):
#
#   A) Certbot DNS-01 + Cloudflare (orange-cloud OK)  ★
#      CERTBOT_AUTH=dns-cloudflare
#      CERTBOT_IMAGE=certbot/dns-cloudflare:v2.11.0
#      CERTBOT_EMAIL=you@domain
#      CLOUDFLARE_API_TOKEN=…   (Zone → DNS → Edit)
#
#   B) Certbot HTTP-01 webroot
#      CERTBOT_AUTH=webroot
#      CERTBOT_EMAIL=you@domain
#      CERTBOT_IMAGE=certbot/certbot:v2.11.0
#
#   C) Cloudflare Origin Certificate (optional)
#      CERTBOT_DISABLE=1
#      + compose volume mount of PEMs → /etc/nginx/origin-certs

# --- GHCR release images (set by Release Please / release-images.yml) ---
# Pin to a semver after a GitHub Release, e.g. ghcr.io/dewnetwork/dew:0.2.0
# Packages must be Public (or docker login ghcr.io) for pull.
# PULL_POLICY=always|missing|never
PULL_POLICY=always
DEW_IMAGE=ghcr.io/dewnetwork/dew:latest
INDEXER_IMAGE=ghcr.io/dewnetwork/dew-indexer:latest
FAUCET_IMAGE=ghcr.io/dewnetwork/dew-faucet:latest
FAUCET_WEB_IMAGE=ghcr.io/dewnetwork/dew-faucet-web:latest
EXPLORER_IMAGE=ghcr.io/dewnetwork/dew-explorer:latest
GUESTBOOK_IMAGE=ghcr.io/dewnetwork/dew-guestbook:latest

# --- Edge nginx (only host-published ports) ---
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443
NGINX_IMAGE=nginx:1.27-alpine
# webroot: certbot/certbot · DNS-01: certbot/dns-cloudflare
CERTBOT_IMAGE=certbot/dns-cloudflare:v2.11.0
CERT_PRIMARY=rpc-dew.fadosoft.com

# --- TLS ---
# CERTBOT_DISABLE=1
CERTBOT_AUTH=dns-cloudflare
CERTBOT_EMAIL=ops@fadosoft.com
# Cloudflare API token: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=
# CERTBOT_STAGING=1
# CERTBOT_DNS_PROPAGATION_SECONDS=30
# CERTBOT_ISSUE_RETRY_SEC=120
# CERTBOT_RENEW_INTERVAL_SEC=43200
# RPC_HOST=rpc-dew.fadosoft.com
# FAUCET_HOST=faucet-dew.fadosoft.com
# EXPLORER_HOST=explorer-dew.fadosoft.com
# GUESTBOOK_HOST=guestbook-dew.fadosoft.com

# --- Dew node genesis (only used with `docker compose … --build`) ---
# GHCR dew image already bakes genesis.public.json.
# genesis.public.json = public path B (faucet alloc only)
# genesis.json        = local dev sample (Anvil alloc — not for public)
DEW_GENESIS_FILE=genesis.public.json

# --- Faucet Service Configuration ---
FAUCET_CHAIN_ID=2205

# Funded private key for the Faucet backend (default is Anvil account #0 for local testing)
# NEVER commit real production keys to git!
FAUCET_PRIVATE_KEY=ac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Admission Mode: allowlist | captcha | dev
FAUCET_MODE=dev

# Allowlist path if FAUCET_MODE=allowlist (relative to deploy/ directory)
FAUCET_ALLOWLIST_PATH=../faucet/allowlist.example.txt

# Amount to transfer per request in Wei (1000000000000000000 Wei = 1 DEW)
FAUCET_AMOUNT_WEI=1000000000000000000

# Rate limits per address
FAUCET_LIMIT_ADDRESS=1
FAUCET_LIMIT_ADDRESS_WINDOW=24h

# Rate limits per client IP
FAUCET_LIMIT_IP=10
FAUCET_LIMIT_IP_WINDOW=1h

# Local only — set false on public
FAUCET_ALLOW_ANVIL_KEY=true

# --- SPA PUBLIC_* (only apply with `docker compose … --build`) ---
# GHCR SPA images bake path B defaults from release-images.yml
# (including PUBLIC_CAPTCHA_* from GitHub Environment "testnet" vars).
# Local/custom captcha or hosts: set below and `up --build`.
PUBLIC_FAUCET_API_URL=/api
PUBLIC_EXPLORER_URL=https://explorer-dew.fadosoft.com
PUBLIC_CAPTCHA_PROVIDER=turnstile
PUBLIC_CAPTCHA_SITE_KEY=

PUBLIC_RPC_URL=https://rpc-dew.fadosoft.com
PUBLIC_CHAIN_ID=2205
PUBLIC_EXPLORER_BASE=https://explorer-dew.fadosoft.com
# P1e history indexer (edge proxies /indexer/ → dewindex). Rebuild explorer to bake.
PUBLIC_INDEXER_URL=https://explorer-dew.fadosoft.com/indexer
# PUBLIC_DEW_PRICE_USD=0.01
# PUBLIC_DEW_PRICE_BTC=
# PUBLIC_DEW_PRICE_CHANGE_24H=
# PUBLIC_DEW_MARKET_CAP_USD=
# PUBLIC_DEW_TOTAL_SUPPLY=

PUBLIC_GUESTBOOK=0x83bB4E539BE46503481E66094b01b854990BF84a
# GUESTBOOK_HOST=guestbook-dew.fadosoft.com

# Explorer address "Token balances" tab (P1d) — path B mock basket (test only)
PUBLIC_KNOWN_TOKENS=USDT:0x43d08b71B0A5626a9D0eB607C2aE5277255cFbC8,USDC:0xacDd0BF26C96879b4c4CeE8F92928f1760F07119,DAI:0x9813B1738eb2982F3D0C1E22F9C7c4F07B670a1B,WETH:0x5b88b2ab38920197328f9D90BaAf29cb91F7E3CB,WBTC:0xdB6E09cb954Ae645C815Bc941bDfD85D4144166E
