# Browser-facing JSON-RPC (devnet or public proxy)
PUBLIC_RPC_URL=http://127.0.0.1:8545
PUBLIC_CHAIN_ID=2205
# Optional canonical base for share links
PUBLIC_EXPLORER_BASE=http://localhost:4321

# Optional market strip (no on-chain oracle — operator-provided)
# PUBLIC_DEW_PRICE_USD=0.01
# PUBLIC_DEW_PRICE_BTC=0.0000001
# PUBLIC_DEW_PRICE_CHANGE_24H=1.42
# PUBLIC_DEW_MARKET_CAP_USD=1000000
# PUBLIC_DEW_TOTAL_SUPPLY=100000000

# Optional known ERC-20 list for address "Token balances" tab (P1d)
# Comma-separated: 0xaddr or SYMBOL:0xaddr
# Path B live mock basket (test only — see docs/ops/public-testnet.md):
# PUBLIC_KNOWN_TOKENS=USDT:0x43d08b71B0A5626a9D0eB607C2aE5277255cFbC8,USDC:0xacDd0BF26C96879b4c4CeE8F92928f1760F07119,DAI:0x9813B1738eb2982F3D0C1E22F9C7c4F07B670a1B,WETH:0x5b88b2ab38920197328f9D90BaAf29cb91F7E3CB,WBTC:0xdB6E09cb954Ae645C815Bc941bDfD85D4144166E
