---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Why from '../components/Why.astro';
import Protocol from '../components/Protocol.astro';
import Performance from '../components/Performance.astro';
import Builders from '../components/Builders.astro';
import Phases from '../components/Phases.astro';
import Cta from '../components/Cta.astro';
import Footer from '../components/Footer.astro';
import { NavScroll } from '../components/react/NavScroll';
---

<BaseLayout>
  <NavScroll client:load />
  <Nav />
  <main>
    <Hero />
    <Why />
    <Protocol />
    <Performance />
    <Builders />
    <Phases />
    <Cta />
  </main>
  <Footer />
</BaseLayout>
