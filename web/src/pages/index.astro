---
import BaseLayout from '../layouts/base-layout.astro';
import Nav from '../components/nav.astro';
import Hero from '../components/hero.astro';
import Network from '../components/network.astro';
import Why from '../components/why.astro';
import Protocol from '../components/protocol.astro';
import Performance from '../components/performance.astro';
import Builders from '../components/builders.astro';
import Phases from '../components/phases.astro';
import Cta from '../components/cta.astro';
import Footer from '../components/footer.astro';
import { NavScroll } from '../components/react/nav-scroll';
---

<BaseLayout>
  <NavScroll client:load />
  <Nav />
  <main>
    <Hero />
    <Network />
    <Why />
    <Protocol />
    <Performance />
    <Builders />
    <Phases />
    <Cta />
  </main>
  <Footer />
</BaseLayout>
