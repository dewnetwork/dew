---
import {
  IconCircleCheck,
  IconCode,
  IconPlugConnected,
  IconRocket,
  IconTerminal2,
  IconTool,
} from '@tabler/icons-react';
import { GlowCard } from './react/GlowCard';
import { Reveal } from './react/Reveal';

const steps = [
  {
    n: '01',
    title: 'Point tooling at Dew',
    body: 'Chain ID and RPC URL from the network docs. Same Foundry / Hardhat configs you already use — swap the endpoint.',
    icon: IconPlugConnected,
  },
  {
    n: '02',
    title: 'Deploy Solidity as usual',
    body: 'Contracts, accounts, and signatures follow the Ethereum path. No new VM to learn before Phase A parity.',
    icon: IconRocket,
  },
  {
    n: '03',
    title: 'Assume one-block finality',
    body: 'Under normal BFT conditions, a commit is final. Design UX and bridges without multi-block confirmation theater.',
    icon: IconCircleCheck,
  },
];
---

<section class="relative py-20 sm:py-28" id="builders">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <Reveal client:load>
      <div class="group/title max-w-2xl">
        <p class="eyebrow">
          <IconTool size={14} stroke={1.75} aria-hidden="true" />
          Builders
        </p>
        <h2 class="section-title mt-3">ETH-first developer experience.</h2>
        <div class="mt-5 h-0.5 w-16 rounded-full dew-edge" aria-hidden="true">
        </div>
        <p class="mt-4 leading-relaxed text-slate">
          Dew-native features never break the default Ethereum path. You keep
          the stack; the chain handles finality and performance underneath.
        </p>
      </div>
    </Reveal>

    <div class="mt-10 grid items-stretch gap-5 lg:grid-cols-2 lg:gap-6">
      <div class="flex min-w-0 flex-col gap-3">
        {
          steps.map((s, i) => {
            const Icon = s.icon;
            return (
              <Reveal client:load delay={0.05 * i}>
                <GlowCard client:visible className="flex items-start gap-4 p-4 sm:p-5">
                  <div class="icon-well" aria-hidden="true">
                    <Icon size={18} stroke={1.6} />
                  </div>
                  <div class="min-w-0 flex-1">
                    <p class="font-mono text-[10px] tracking-wider text-muted uppercase">
                      Step {s.n}
                    </p>
                    <h3 class="mt-1 font-display text-lg font-semibold text-frost">
                      {s.title}
                    </h3>
                    <p class="mt-1.5 text-sm leading-relaxed text-slate">
                      {s.body}
                    </p>
                  </div>
                </GlowCard>
              </Reveal>
            );
          })
        }
      </div>

      <Reveal client:load delay={0.08} className="min-w-0 h-full">
        <div
          class="terminal-frame flex h-full min-h-full flex-col overflow-hidden rounded-2xl border border-[var(--color-line)] bg-ink shadow-[var(--shadow-panel)]"
        >
          <div
            class="flex shrink-0 items-center gap-2 border-b border-[var(--color-line)] bg-panel/40 px-4 py-3"
          >
            <span class="h-2.5 w-2.5 shrink-0 rounded-full bg-[#ff5f57]"
            ></span>
            <span class="h-2.5 w-2.5 shrink-0 rounded-full bg-[#febc2e]"
            ></span>
            <span class="h-2.5 w-2.5 shrink-0 rounded-full bg-[#28c840]"
            ></span>
            <span
              class="ml-2 inline-flex min-w-0 items-center gap-1.5 truncate font-mono text-[11px] tracking-wide text-muted"
            >
              <IconTerminal2 size={13} stroke={1.75} aria-hidden="true" />
              foundry · dew-local
            </span>
          </div>

          <div class="flex min-h-0 flex-1 flex-col justify-center overflow-x-auto">
            <pre
              class="m-0 p-5 font-mono text-[12.5px] leading-[1.7] whitespace-pre text-mist sm:p-6 sm:text-[13px]"
            ><code class="block"><span class="text-muted"># Deploy against a local Dew node</span>
<span class="text-teal">export</span> ETH_RPC_URL=http://127.0.0.1:8545

forge create src/Counter.sol:Counter \
  --rpc-url $ETH_RPC_URL \
  --private-key $DEPLOYER_KEY \
  --broadcast

<span class="text-muted"># Finality: one commit, not N confirmations</span>
cast receipt $TX_HASH --rpc-url $ETH_RPC_URL</code></pre>
          </div>

          <div
            class="flex shrink-0 items-start gap-2 border-t border-[var(--color-line)] bg-panel/40 px-5 py-3.5 font-mono text-[11px] leading-snug text-muted"
          >
            <IconCode
              size={14}
              stroke={1.75}
              className="mt-0.5 shrink-0 text-cyan"
              aria-hidden="true"
            />
            <span>JSON-RPC: eth_* · net_* · web3_* — dew_* after parity</span>
          </div>
        </div>
      </Reveal>
    </div>
  </div>
</section>
