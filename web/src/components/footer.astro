---
import {
  IconBrandGithub,
  IconBook2,
  IconExternalLink,
} from '@tabler/icons-react';
import { withBase } from '../lib/paths';
import { PUBLIC_NETWORK } from '../lib/network';

const year = new Date().getFullYear();
const home = withBase('/');
const docs = withBase('/docs');
const tryPublic = withBase('/docs/ops/try-public');
const logo = withBase('/logo.svg');

const cols = [
  {
    title: 'Product',
    links: [
      { href: '#network', label: 'Live network' },
      { href: '#protocol', label: 'Protocol' },
      { href: '#phases', label: 'Phases' },
      { href: '#why', label: 'Why Dew' },
    ],
  },
  {
    title: 'Builders',
    links: [
      { href: '#builders', label: 'Developer path' },
      { href: tryPublic, label: 'Try public (5 min)' },
      { href: docs, label: 'Docs' },
    ],
  },
  {
    title: 'Live',
    links: [
      {
        href: PUBLIC_NETWORK.faucet,
        label: 'Faucet',
        external: true,
      },
      {
        href: PUBLIC_NETWORK.explorer,
        label: 'Explorer',
        external: true,
      },
      {
        href: PUBLIC_NETWORK.guestbook,
        label: 'Guestbook',
        external: true,
      },
      {
        href: PUBLIC_NETWORK.rpc,
        label: 'RPC',
        external: true,
      },
    ],
  },
];
---

<footer class="border-t border-[var(--color-line)] pb-10">
  <div class="mx-auto max-w-6xl px-5 pt-14 sm:px-8">
    <div class="flex flex-col gap-10 lg:flex-row lg:justify-between">
      <div class="max-w-xs">
        <a href={home} class="flex items-center gap-2.5">
          <img
            src={logo}
            alt=""
            width="28"
            height="28"
            class="rounded-lg"
          />
          <span class="font-display text-lg font-bold text-frost">Dew</span>
        </a>
        <p class="mt-4 text-sm leading-relaxed text-muted">
          High-performance EVM L1. Faster finality, flatter state, ETH-first DX.
        </p>
        <p class="mt-3 font-mono text-[11px] tracking-wide text-mist">
          {PUBLIC_NETWORK.freezeTag} · chain {PUBLIC_NETWORK.chainId}
        </p>
        <div class="mt-5 flex items-center gap-2">
          <a
            href="https://github.com/dewnetwork/dew"
            class="icon-well-sm text-slate transition hover:border-cyan/40 hover:text-cyan"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub"
          >
            <IconBrandGithub size={15} stroke={1.75} />
          </a>
          <a
            href={docs}
            class="icon-well-sm text-slate transition hover:border-cyan/40 hover:text-cyan"
            aria-label="Documentation"
          >
            <IconBook2 size={15} stroke={1.75} />
          </a>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3 sm:gap-12">
        {
          cols.map((col) => (
            <div>
              <p class="font-mono text-[10px] tracking-[0.14em] text-muted uppercase">
                {col.title}
              </p>
              <ul class="mt-3 m-0 list-none space-y-2 p-0">
                {col.links.map((l) => (
                  <li class="m-0 list-none p-0">
                    <a
                      href={l.href}
                      class="inline-flex items-center gap-1 text-sm text-slate transition hover:text-frost"
                      {...(l.external
                        ? {
                            target: '_blank',
                            rel: 'noopener noreferrer',
                          }
                        : {})}
                    >
                      {l.label}
                      {l.external && (
                        <IconExternalLink
                          size={12}
                          stroke={1.75}
                          className="opacity-50"
                          aria-hidden
                        />
                      )}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div
      class="mt-12 flex flex-col gap-2 border-t border-[var(--color-line)] pt-6 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="font-mono text-[11px] text-muted">
        © {year} Dew Network · Apache-2.0
      </p>
      <p class="font-mono text-[11px] text-muted">
        Go core · explorer · faucet · docs
      </p>
    </div>
  </div>
</footer>
