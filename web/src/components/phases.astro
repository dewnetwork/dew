---
import {
  IconCircleCheck,
  IconCpu,
  IconGitBranch,
  IconRocket,
  IconShieldCheck,
  IconWorldWww,
} from '@tabler/icons-react';
import { GlowCard } from './react/glow-card';
import { Reveal } from './react/reveal';

const phases = [
  {
    id: 'A',
    title: 'Correct & compatible',
    status: 'Done',
    statusTone: 'done' as const,
    icon: IconShieldCheck,
    items: [
      'Sequential EVM + eth_* RPC',
      'Dew-BFT multi-validator',
      'Flat state + local devnet',
      'MetaMask / Foundry path',
    ],
  },
  {
    id: 'B',
    title: 'Native & parallel',
    status: 'Done',
    statusTone: 'done' as const,
    icon: IconCpu,
    items: [
      'Optimistic parallel exec',
      'DewTx native format',
      'System precompiles',
      'Load / security baselining',
    ],
  },
  {
    id: 'C',
    title: 'Testnet readiness',
    status: 'Live',
    statusTone: 'live' as const,
    icon: IconWorldWww,
    items: [
      'Mempool & fee floors',
      'Encrypted P2P + SMT roots',
      'public-testnet-v1 freeze',
      'Path B RPC surface',
    ],
  },
  {
    id: 'D',
    title: 'Product & scale',
    status: 'Partial',
    statusTone: 'partial' as const,
    icon: IconRocket,
    items: [
      'Explorer + faucet shipped',
      'Guestbook SPA demo',
      'Durable chaindata / multiproc',
      'Path A & audit on demand',
    ],
  },
];

const toneClass: Record<(typeof phases)[number]['statusTone'], string> = {
  done: 'border-teal/35 bg-teal/10 text-mist',
  live: 'border-cyan/40 bg-cyan/10 text-cyan',
  partial: 'border-gold/35 bg-gold/10 text-gold',
};
---

<section class="relative py-20 sm:py-28" id="phases">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <Reveal client:load>
      <div
        class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between"
      >
        <div class="max-w-xl">
          <p class="eyebrow">
            <IconGitBranch size={14} stroke={1.75} />
            Build order
          </p>
          <h2 class="section-title mt-3">
            Complexity only after correctness.
          </h2>
          <div class="mt-5 h-0.5 w-16 rounded-full dew-edge" aria-hidden="true">
          </div>
        </div>
        <p class="max-w-sm text-sm text-slate">
          A–C are complete. Product surface (D1–D2) is live; scale workstreams
          (Path A, staking residuals, external audit) stay on demand.
        </p>
      </div>
    </Reveal>

    <div class="mt-12">
      <div class="relative mb-5 hidden lg:block" aria-hidden="true">
        <div
          class="pointer-events-none absolute top-1/2 right-[calc(12.5%+1rem)] left-[calc(12.5%+1rem)] h-px -translate-y-1/2 bg-gradient-to-r from-cyan/40 via-cyan/25 to-cyan/15"
        >
        </div>
        <div class="relative z-10 grid grid-cols-4 gap-4">
          {
            phases.map((phase) => {
              const Icon = phase.icon;
              return (
                <div class="flex justify-center">
                  <span class="flex h-11 w-11 items-center justify-center rounded-full border border-cyan/30 bg-ink text-cyan shadow-[0_0_24px_-8px_rgb(94_234_212_/_0.5)] ring-4 ring-ink">
                    <Icon size={18} stroke={1.7} />
                  </span>
                </div>
              );
            })
          }
        </div>
      </div>

      <ol
        class="m-0 grid list-none grid-cols-1 gap-4 p-0 sm:grid-cols-2 lg:grid-cols-4"
      >
        {
          phases.map((phase, i) => {
            const Icon = phase.icon;
            return (
              <li class="m-0 min-w-0 list-none p-0">
                <Reveal client:load delay={0.06 * i} className="h-full">
                  <GlowCard client:visible className="flex h-full flex-col p-5 sm:p-6">
                    <div class="flex items-center justify-between gap-3">
                      <span class="icon-well lg:hidden">
                        <Icon size={18} stroke={1.6} />
                      </span>
                      <span class="hidden items-center gap-2 font-mono text-[10px] tracking-[0.14em] text-muted uppercase lg:inline-flex">
                        Phase {phase.id}
                      </span>
                      <span
                        class={`rounded-full border px-2.5 py-1 font-mono text-[10px] tracking-wide uppercase ${toneClass[phase.statusTone]}`}
                      >
                        {phase.status}
                      </span>
                    </div>
                    <h3 class="mt-5 font-display text-lg font-bold text-frost sm:text-xl">
                      {phase.title}
                    </h3>
                    <ul class="m-0 mt-4 list-none space-y-2.5 p-0">
                      {phase.items.map((item) => (
                        <li class="m-0 flex list-none items-start gap-2.5 p-0 text-sm text-slate">
                          <IconCircleCheck
                            size={15}
                            stroke={1.75}
                            className="mt-0.5 shrink-0 text-teal"
                            aria-hidden
                          />
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>
                  </GlowCard>
                </Reveal>
              </li>
            );
          })
        }
      </ol>
    </div>
  </div>
</section>
