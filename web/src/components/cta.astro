---
import {
  IconArrowUpRight,
  IconBook2,
  IconBrandGithub,
  IconFlag,
  IconRocket,
} from '@tabler/icons-react';
import { AddNetworkButton } from './react/add-network-button';
import { Reveal } from './react/reveal';
import { withBase } from '../lib/paths';
import { PUBLIC_NETWORK } from '../lib/network';

const docs = withBase('/docs');
const tryPublic = withBase('/docs/ops/try-public');
---

<section class="relative py-16 sm:py-24">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <Reveal client:load>
      <div
        class="relative overflow-hidden rounded-3xl border border-[var(--color-line)] px-6 py-12 sm:px-12 sm:py-16"
      >
        <div
          class="pointer-events-none absolute inset-0 bg-gradient-to-br from-teal/20 via-ink-soft to-ink"
          aria-hidden="true"
        >
        </div>
        <div
          class="pointer-events-none absolute -top-24 right-0 h-64 w-64 rounded-full bg-cyan/20 blur-3xl"
          aria-hidden="true"
        >
        </div>
        <div
          class="pointer-events-none absolute bottom-0 left-1/3 h-40 w-40 rounded-full bg-teal/10 blur-3xl"
          aria-hidden="true"
        >
        </div>

        <div class="relative max-w-2xl">
          <p class="eyebrow !text-mist">
            <IconFlag size={14} stroke={1.75} />
            Next step
          </p>
          <h2 class="section-title mt-3">
            Touch the live testnet in five minutes.
          </h2>
          <p class="mt-4 leading-relaxed text-slate">
            Faucet, MetaMask (chain {PUBLIC_NETWORK.chainId}), Guestbook sign, and
            explorer — no node build required. Protocol docs live in the same
            repo when you are ready to go deeper.
          </p>
          <div class="mt-8 flex flex-wrap items-start gap-3">
            <a href={tryPublic} class="btn-primary px-6 py-3">
              <IconRocket size={17} stroke={1.75} />
              Try public testnet
              <IconArrowUpRight size={16} stroke={2} />
            </a>
            <AddNetworkButton client:load variant="secondary" showStatus={false} />
            <a href={docs} class="btn-secondary px-6 py-3">
              <IconBook2 size={17} stroke={1.75} />
              Open documentation
            </a>
            <a
              href="https://github.com/dewnetwork/dew"
              class="btn-secondary px-6 py-3"
              target="_blank"
              rel="noopener noreferrer"
            >
              <IconBrandGithub size={17} stroke={1.75} />
              View on GitHub
            </a>
          </div>
          <p class="mt-5 font-mono text-[11px] tracking-wide text-muted">
            {PUBLIC_NETWORK.pathNote}
          </p>
        </div>
      </div>
    </Reveal>
  </div>
</section>
