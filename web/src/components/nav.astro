---
import {
  IconArrowRight,
  IconBook2,
  IconBrandGithub,
  IconGitBranch,
  IconLayersLinked,
  IconNetwork,
  IconRocket,
  IconTool,
} from '@tabler/icons-react';
import { MobileNav } from './react/mobile-nav';
import { withBase } from '../lib/paths';

const home = withBase('/');
const docs = withBase('/docs');
const tryPublic = withBase('/docs/ops/try-public');
const logo = withBase('/logo.svg');

const links = [
  {
    href: '#network',
    label: 'Network',
    icon: IconNetwork,
    iconKey: 'network' as const,
  },
  {
    href: '#protocol',
    label: 'Protocol',
    icon: IconLayersLinked,
    iconKey: 'protocol' as const,
  },
  {
    href: '#builders',
    label: 'Builders',
    icon: IconTool,
    iconKey: 'builders' as const,
  },
  {
    href: '#phases',
    label: 'Phases',
    icon: IconGitBranch,
    iconKey: 'phases' as const,
  },
  {
    href: docs,
    label: 'Docs',
    icon: IconBook2,
    iconKey: 'docs' as const,
  },
];

const mobileLinks = links.map(({ href, label, iconKey }) => ({
  href,
  label,
  icon: iconKey,
}));
---

<header
  class="site-nav fixed inset-x-0 top-0 z-40 border-b border-[var(--color-line)] bg-ink/80 backdrop-blur-xl"
>
  <div
    class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5 sm:gap-6 sm:px-8"
  >
    <a href={home} class="group flex items-center gap-2.5" aria-label="Dew home">
      <img
        src={logo}
        alt=""
        width="28"
        height="28"
        class="rounded-lg ring-1 ring-[var(--color-line)] transition group-hover:ring-cyan/40"
      />
      <span
        class="font-display text-[1.05rem] font-bold tracking-tight text-frost"
      >
        Dew
      </span>
    </a>

    <nav class="hidden items-center gap-0.5 lg:flex" aria-label="Primary">
      {
        links.map((link) => {
          const Icon = link.icon;
          return (
            <a href={link.href} class="nav-link">
              <Icon size={15} stroke={1.75} aria-hidden="true" />
              {link.label}
            </a>
          );
        })
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href="https://github.com/dewnetwork/dew"
        class="hidden items-center gap-1.5 rounded-lg px-3 py-2 font-mono text-xs text-muted transition-colors hover:bg-panel/50 hover:text-frost sm:inline-flex"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub repository"
      >
        <IconBrandGithub size={16} stroke={1.75} />
        <span>GitHub</span>
      </a>
      <a href={tryPublic} class="btn-primary hidden !px-4 !py-2 sm:inline-flex">
        <IconRocket size={16} stroke={1.75} />
        Try public
        <IconArrowRight size={16} stroke={2} />
      </a>
      <MobileNav
        client:load
        links={mobileLinks}
        tryPublicHref={tryPublic}
      />
    </div>
  </div>
</header>
