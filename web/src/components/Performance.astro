---
import {
  IconActivity,
  IconBolt,
  IconChartBar,
  IconClockHour4,
  IconCoin,
} from '@tabler/icons-react';
import { Reveal } from './react/Reveal';

const metrics = [
  {
    label: 'Target block time',
    value: '~1s',
    note: 'Steady proposer rotation under Dew-BFT',
    icon: IconClockHour4,
  },
  {
    label: 'Finality model',
    value: 'Instant',
    note: 'Commit = final under BFT assumptions',
    icon: IconBolt,
  },
  {
    label: 'Throughput path',
    value: 'k+ TPS',
    note: 'After parallel execution lands (Phase B)',
    icon: IconActivity,
  },
  {
    label: 'Genesis supply',
    value: '1B DEW',
    note: '18 decimals · wei base unit',
    icon: IconCoin,
  },
];
---

<section class="relative py-16 sm:py-20">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <Reveal client:load>
      <div
        class="overflow-hidden rounded-3xl border border-[var(--color-line)] bg-panel/40 shadow-[var(--shadow-card)]"
      >
        <div
          class="flex flex-col gap-2 border-b border-[var(--color-line)] px-6 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-8"
        >
          <p class="eyebrow !text-mist">
            <IconChartBar size={14} stroke={1.75} />
            Directional targets
          </p>
          <p class="font-mono text-[11px] text-muted">
            Normative values live in protocol docs · tentative where marked
          </p>
        </div>
        <dl
          class="grid divide-y divide-[var(--color-line)] sm:grid-cols-2 sm:divide-x sm:divide-y-0 lg:grid-cols-4"
        >
          {
            metrics.map((m, i) => {
              const Icon = m.icon;
              return (
                <Reveal
                  client:load
                  delay={0.05 * i}
                  className="px-6 py-7 sm:px-8"
                >
                  <dt class="flex items-center gap-2 font-mono text-[10px] tracking-wider text-muted uppercase">
                    <span class="icon-well-sm">
                      <Icon size={14} stroke={1.75} />
                    </span>
                    {m.label}
                  </dt>
                  <dd class="mt-3 font-display text-3xl font-bold tracking-tight text-frost">
                    {m.value}
                  </dd>
                  <p class="mt-2 text-xs leading-relaxed text-slate">{m.note}</p>
                </Reveal>
              );
            })
          }
        </dl>
      </div>
    </Reveal>
  </div>
</section>
