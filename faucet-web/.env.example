# Browser → dewfaucet HTTP API (no secrets).
# Leave empty in dev to use Vite proxy (/api → http://127.0.0.1:8080).
PUBLIC_FAUCET_API_URL=

# Optional: explorer deep-link for successful drip tx hashes
PUBLIC_EXPLORER_URL=

# Captcha mode only (public site key — never the secret)
PUBLIC_CAPTCHA_PROVIDER=
PUBLIC_CAPTCHA_SITE_KEY=
