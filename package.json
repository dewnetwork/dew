{
  "name": "dew",
  "version": "0.1.0",
  "private": true,
  "description": "Dew monorepo — Go L1 core + Node docs website and tooling",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.13.0",
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "web:dev": "pnpm --dir web dev",
    "web:build": "pnpm --dir web build",
    "web:preview": "pnpm --dir web preview",
    "explorer:dev": "pnpm --dir explorer dev",
    "explorer:build": "pnpm --dir explorer build",
    "explorer:preview": "pnpm --dir explorer preview",
    "faucet:dev": "pnpm --dir faucet-web dev",
    "faucet:build": "pnpm --dir faucet-web build",
    "faucet:preview": "pnpm --dir faucet-web preview",
    "guestbook:dev": "pnpm --dir examples/guestbook-web dev",
    "guestbook:build": "pnpm --dir examples/guestbook-web build",
    "guestbook:preview": "pnpm --dir examples/guestbook-web preview",
    "build": "node scripts/build-site.mjs",
    "site:build": "node scripts/build-site.mjs",
    "site:preview": "npx --yes serve dist -l 4173",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "rpc:smoke": "node scripts/smoke-rpc.mjs",
    "devnet:erc20": "node scripts/devnet-erc20.mjs"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=11"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "dayjs": "^1.11.21",
    "ethers": "^6.17.0",
    "markdown-it-mathjax3": "^4.3.2",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.16.0",
    "typescript": "^5.8.2",
    "vitepress": "2.0.0-alpha.18",
    "vitepress-mermaid-renderer": "^1.1.28",
    "vue": "^3.5.39",
    "yaml": "^2.7.0"
  }
}
