{
  "name": "dew",
  "version": "0.1.0",
  "private": true,
  "description": "Dew monorepo — Go L1 core + Node docs website and tooling",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "web:dev": "pnpm --dir web dev",
    "web:build": "pnpm --dir web build",
    "web:preview": "pnpm --dir web preview",
    "build": "node scripts/build-site.mjs",
    "site:build": "node scripts/build-site.mjs",
    "site:preview": "npx --yes serve dist -l 4173",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "rpc:smoke": "node scripts/smoke-rpc.mjs"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "dayjs": "^1.11.21",
    "mermaid": "^11.16.0",
    "typescript": "^5.8.2",
    "vitepress": "^1.6.3",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vue": "^3.5.13",
    "yaml": "^2.7.0"
  }
}

